// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────
enum DealStage {
  new
  ingesting
  ready
  under_review
  archived
}

enum DocumentType {
  pdf
  docx
  txt
  pptx
  xlsx
  csv
  other
}

enum DocumentStatus {
  uploaded
  extracting
  chunked
  embedded
  failed
}

enum WebSourceStatus {
  queued
  fetched
  parsed
  failed
  stale
}

enum MessageRole {
  user
  assistant
  system
}

enum MemoStatus {
  draft
  review_required
  approved
  exported
}

enum CheckStatus {
  found
  partially_found
  missing
  contradicted
  needs_review
}

enum JobType {
  document_ingest
  web_enrich
  generate_memo
  generate_followups
  reprocess_document
  score_checklist
}

enum JobStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum CitationSourceKind {
  document_chunk
  web_chunk
}

enum FollowupGroup {
  team_hiring
  product_roadmap
  revenue_customers
  legal_compliance
  fundraise_captable
}

// ─── MODELS ───────────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  deals       Deal[]
  usageEvents UsageEvent[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("member") // "owner" | "member"
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  @@unique([userId, organizationId])
}

model Deal {
  id               String             @id @default(cuid())
  organizationId   String
  name             String
  startupName      String
  website          String?
  linkedinUrl      String?
  notes            String?            @db.Text
  stage            DealStage          @default(new)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id])
  documents        Document[]
  webSources       WebSource[]
  dealNotes        DealNote[]
  qaSessions       QASession[]
  memos            Memo[]
  followupQuestions FollowupQuestion[]
  diligenceChecks  DiligenceCheck[]
  jobs             Job[]
  usageEvents      UsageEvent[]

  @@index([organizationId, createdAt])
}

model Document {
  id          String         @id @default(cuid())
  dealId      String
  name        String
  type        DocumentType
  status      DocumentStatus @default(uploaded)
  sizeBytes   Int?
  storageKey  String?        // null in free mode (we don't store binary)
  extractedAt DateTime?
  error       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deal        Deal           @relation(fields: [dealId], references: [id])
  chunks      DocumentChunk[]
  citations   Citation[]
  jobs        Job[]

  @@index([dealId, status])
}

model DocumentChunk {
  id           String    @id @default(cuid())
  documentId   String
  dealId       String
  text         String    @db.Text
  pageNumber   Int?
  sectionLabel String?
  chunkIndex   Int
  // embedding stored as raw float array — use pgvector raw SQL for similarity search
  embedding    Bytes?
  createdAt    DateTime  @default(now())
  document     Document  @relation(fields: [documentId], references: [id])
  citations    Citation[]

  @@index([dealId])
  @@index([documentId])
}

model WebSource {
  id          String          @id @default(cuid())
  dealId      String
  url         String
  sourceType  String          // homepage, about, pricing, etc.
  status      WebSourceStatus @default(queued)
  fetchedAt   DateTime?
  error       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deal        Deal            @relation(fields: [dealId], references: [id])
  chunks      WebChunk[]

  @@index([dealId, sourceType])
}

model WebChunk {
  id           String    @id @default(cuid())
  webSourceId  String
  dealId       String
  text         String    @db.Text
  url          String
  sectionLabel String?
  chunkIndex   Int
  embedding    Bytes?
  createdAt    DateTime  @default(now())
  webSource    WebSource @relation(fields: [webSourceId], references: [id])
  citations    Citation[]

  @@index([dealId])
  @@index([webSourceId])
}

model DealNote {
  id        String   @id @default(cuid())
  dealId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id])
}

model QASession {
  id        String    @id @default(cuid())
  dealId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deal      Deal      @relation(fields: [dealId], references: [id])
  messages  Message[]
}

model Message {
  id          String      @id @default(cuid())
  sessionId   String
  role        MessageRole
  content     String      @db.Text
  createdAt   DateTime    @default(now())
  session     QASession   @relation(fields: [sessionId], references: [id])
  citations   Citation[]
}

model Memo {
  id        String      @id @default(cuid())
  dealId    String
  version   Int         @default(1)
  status    MemoStatus  @default(draft)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deal      Deal        @relation(fields: [dealId], references: [id])
  sections  MemoSection[]
}

model MemoSection {
  id             String   @id @default(cuid())
  memoId         String
  sectionKey     String   // "team", "traction", "risks", etc.
  generatedText  String   @db.Text
  editedText     String?  @db.Text
  approved       Boolean  @default(false)
  editor         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  memo           Memo     @relation(fields: [memoId], references: [id])
  citations      Citation[]
}

model FollowupQuestion {
  id        String        @id @default(cuid())
  dealId    String
  group     FollowupGroup
  question  String        @db.Text
  rationale String?       @db.Text
  createdAt DateTime      @default(now())
  deal      Deal          @relation(fields: [dealId], references: [id])
}

model DiligenceCheck {
  id          String      @id @default(cuid())
  dealId      String
  category    String
  item        String
  status      CheckStatus @default(missing)
  confidence  Float?      // 0.0 to 1.0
  rationale   String?     @db.Text
  computedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deal        Deal        @relation(fields: [dealId], references: [id])

  @@index([dealId, category, status])
}

model Citation {
  id              String             @id @default(cuid())
  sourceKind      CitationSourceKind
  documentChunkId String?
  webChunkId      String?
  documentId      String?
  pageNumber      Int?
  sectionLabel    String?
  excerpt         String             @db.Text
  // Relations to where this citation is used
  messageId       String?
  memoSectionId   String?
  createdAt       DateTime           @default(now())
  documentChunk   DocumentChunk?     @relation(fields: [documentChunkId], references: [id])
  webChunk        WebChunk?          @relation(fields: [webChunkId], references: [id])
  document        Document?          @relation(fields: [documentId], references: [id])
  message         Message?           @relation(fields: [messageId], references: [id])
  memoSection     MemoSection?       @relation(fields: [memoSectionId], references: [id])
}

model Job {
  id          String    @id @default(cuid())
  dealId      String
  documentId  String?
  type        JobType
  status      JobStatus @default(queued)
  attempts    Int       @default(0)
  error       String?   @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deal        Deal      @relation(fields: [dealId], references: [id])
  document    Document? @relation(fields: [documentId], references: [id])

  @@index([dealId, type, status])
}

model UsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  dealId         String?
  eventType      String       // "tokens_in", "tokens_out", "embedding", "upload", "export", etc.
  quantity       Int          @default(1)
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  deal           Deal?        @relation(fields: [dealId], references: [id])

  @@index([organizationId, createdAt])
}